# Copy this file to .env and fill in the values before running
# `docker compose up`. See apps/www/src/content/docs/self-hosting-docker/en.mdx
# for the full walkthrough.

# Host port to publish the server on (container always listens on 8787).
# PORT=8787

# The address clients will reach this server at, with no trailing slash.
# Must match how you actually access it (including the port, if you're not
# putting this behind a reverse proxy) - better-auth rejects requests whose
# Origin doesn't match this.
PUBLIC_URL=http://localhost:8787

# Two independent random secrets. Generate each with, e.g.:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=
SYNC_TOKEN_SECRET=

# Required comma-separated allowlist for new account sign-ups. Existing users
# can still sign in after their address is removed from this list.
AUTH_ALLOWED_EMAILS=you@example.com,family@example.com

# Uncomment to restrict which origins may call the API (defaults to PUBLIC_URL).
# CORS_ORIGIN=https://your-domain.example

# Interface to bind to. Defaults to 0.0.0.0 (all interfaces) - required for
# Docker Compose's port publishing to work at all. If you're running the
# systemd deployment behind a local reverse proxy only (e.g. `tailscale
# serve`, nginx, Caddy) and want to stop the server from being reachable
# directly on your LAN/public interface, set this to 127.0.0.1 instead - the
# example systemd unit already does this for you.
# HOST=127.0.0.1

# Blob storage backend: "disk" (default, stored under the data volume) or "s3".
# Disk uploads use <blob-directory>.uploads/*.part beside the blob directory.
# Keep both directories on the same filesystem. With a single server using
# the storage, abandoned parts are removed before accepting requests.
# BLOB_STORAGE=s3
# S3_ENDPOINT=https://your-s3-compatible-endpoint
# S3_BUCKET=synch-blobs
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Total time allowed to receive an HTTP request, in milliseconds (default 300000).
# For slow uploads, increase up to 1500000 (25 minutes); also check your proxy.
# REQUEST_TIMEOUT_MS=900000
