# Copy this file to .env and fill in the values before running
# `docker compose up`. See apps/www/src/content/docs/self-hosting-docker/en.mdx
# for the full walkthrough.

# Host port to publish the server on (container always listens on 8787).
# PORT=8787

# The address clients will reach this server at, with no trailing slash.
# Must match how you actually access it (including the port, if you're not
# putting this behind a reverse proxy) - better-auth rejects requests whose
# Origin doesn't match this.
PUBLIC_URL=http://localhost:8787

# Two independent random secrets. Generate each with, e.g.:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=
SYNC_TOKEN_SECRET=

# Uncomment to restrict which origins may call the API (defaults to PUBLIC_URL).
# CORS_ORIGIN=https://your-domain.example

# Blob storage backend: "disk" (default, stored under the data volume) or "s3".
# BLOB_STORAGE=s3
# S3_ENDPOINT=https://your-s3-compatible-endpoint
# S3_BUCKET=synch-blobs
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
