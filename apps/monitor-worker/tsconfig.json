{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "ES2022",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"strict": true,
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"types": ["@cloudflare/workers-types", "node"]
	},
	"include": ["src/**/*.ts", "tests/**/*.ts"]
}
