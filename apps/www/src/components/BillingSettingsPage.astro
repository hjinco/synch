---
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import Layout from "../layouts/Layout.astro";
import { localizedPath, ui, type Locale } from "../i18n";
import { PLUS_PRICING_USD } from "../billing/pricing";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const apiUrl = import.meta.env.PUBLIC_API_URL || "";
const authBaseUrl = apiUrl || Astro.url.origin;
const billingUrl = new URL(localizedPath(locale, "/billing"), Astro.url.origin).toString();
const signupUrl = new URL("/signup", authBaseUrl);
signupUrl.searchParams.set("return_to", billingUrl);
signupUrl.searchParams.set("lang", locale);
const pricingUrl = localizedPath(locale, "/pricing");
---

<Layout title={t.meta.billingTitle} description={t.meta.billingDescription} locale={locale} noindex>
  <div class="max-w-2xl mx-auto px-6 w-full flex-1 flex flex-col">
    <Header locale={locale} />

    <main class="flex-1 py-16">
      <div class="space-y-3 mb-10">
        <p class="text-xs text-zinc-600">{t.billingSettings.eyebrow}</p>
        <h1 class="text-2xl sm:text-3xl text-zinc-200 tracking-tight">
          {t.billingSettings.heading}
        </h1>
        <p class="text-zinc-500 max-w-md leading-relaxed">
          {t.billingSettings.subheading}
        </p>
      </div>

      <section
        class="rounded-lg border border-zinc-800/50 bg-zinc-900/20 p-6"
        aria-live="polite"
      >
        <div id="billing-loading" class="flex items-center gap-3 text-sm text-zinc-500">
          <div class="h-4 w-4 animate-spin rounded-full border-2 border-zinc-700 border-t-zinc-300" aria-hidden="true"></div>
          <span>{t.billingSettings.loading}</span>
        </div>

        <div id="billing-content" class="hidden space-y-8">
          <label class="block text-sm text-zinc-400"><span id="organization-label"></span><select id="billing-organization" class="mt-2 block w-full rounded border border-zinc-700 bg-zinc-950 px-3 py-2"></select></label>
          <div id="plus-checkout" class="flex flex-wrap gap-3"></div>
          <p id="plus-pricing-note" class="hidden text-xs leading-relaxed text-zinc-400">{t.pricing.plusOrganizationPrice}</p>
          <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <p class="mb-2 text-xs text-zinc-600">{t.billingSettings.currentPlan}</p>
              <div class="flex flex-wrap items-center gap-3">
                <h2 id="billing-plan" class="text-xl text-zinc-200"></h2>
                <span
                  id="billing-badge"
                  class="rounded border border-zinc-700 bg-zinc-950/60 px-2 py-1 text-[11px] font-medium text-zinc-400"
                ></span>
              </div>
              <p id="billing-price" class="hidden mt-2 text-sm text-zinc-400"></p>
            </div>
            <div id="billing-period-group" class="text-left sm:text-right">
              <p id="billing-period-label" class="mb-2 text-xs text-zinc-600">
                {t.billingSettings.renewal}
              </p>
              <p id="billing-period" class="text-sm text-zinc-400"></p>
            </div>
          </div>

          <p id="billing-message" class="text-sm leading-relaxed text-zinc-500"></p>

          <div class="flex flex-col gap-3 sm:flex-row">
            <button
              id="manage-button"
              type="button"
              class="hidden rounded bg-zinc-200 px-4 py-2 text-sm font-medium text-[#0a0a0a] transition-colors hover:bg-white disabled:bg-zinc-800/50 disabled:text-zinc-500 disabled:cursor-not-allowed"
            >
              {t.billingSettings.manage}
            </button>
            <button
              id="switch-interval-button"
              type="button"
              class="hidden rounded bg-zinc-800 px-4 py-2 text-sm font-medium text-zinc-200 transition-colors hover:bg-zinc-700 disabled:cursor-not-allowed disabled:bg-zinc-800/50 disabled:text-zinc-500"
            >
              {t.billingSettings.switchToAnnual}
            </button>
            <a
              id="upgrade-link"
              href={pricingUrl}
              class="hidden rounded bg-zinc-200 px-4 py-2 text-center text-sm font-medium text-[#0a0a0a] transition-colors hover:bg-white"
            >
              {t.billingSettings.upgrade}
            </a>
          </div>
        </div>

        <div id="billing-auth" class="hidden space-y-5">
          <p class="text-sm leading-relaxed text-zinc-500">
            {t.billingSettings.authRequired}
          </p>
          <a
            href={signupUrl.toString()}
            class="inline-flex rounded bg-zinc-200 px-4 py-2 text-sm font-medium text-[#0a0a0a] transition-colors hover:bg-white"
          >
            {t.billingSettings.signIn}
          </a>
        </div>

        <div id="billing-error" class="hidden space-y-5">
          <p id="billing-error-message" class="text-sm leading-relaxed text-zinc-500">
            {t.billingSettings.error}
          </p>
          <button
            id="retry-button"
            type="button"
            class="rounded bg-zinc-800 px-4 py-2 text-sm font-medium text-zinc-200 transition-colors hover:bg-zinc-700"
          >
            {t.billingSettings.retry}
          </button>
        </div>
      </section>
    </main>

    <Footer locale={locale} />
  </div>
</Layout>

<script
  define:vars={{
    apiUrl,
    labels: t.billingSettings,
    returnPath: localizedPath(locale, "/billing"),
    signupUrl: signupUrl.toString(),
    locale,
    plusPricing: PLUS_PRICING_USD,
    monthLabel: t.pricing.month,
    yearLabel: t.pricing.year,
    plusOrganizationPrice: t.pricing.plusOrganizationPrice,
  }}
>
  const loading = document.getElementById("billing-loading");
  const content = document.getElementById("billing-content");
  const auth = document.getElementById("billing-auth");
  const error = document.getElementById("billing-error");
  const plan = document.getElementById("billing-plan");
  const badge = document.getElementById("billing-badge");
  const price = document.getElementById("billing-price");
  const periodGroup = document.getElementById("billing-period-group");
  const periodLabel = document.getElementById("billing-period-label");
  const period = document.getElementById("billing-period");
  const message = document.getElementById("billing-message");
  const manageButton = document.getElementById("manage-button");
  const switchIntervalButton = document.getElementById("switch-interval-button");
  const upgradeLink = document.getElementById("upgrade-link");
  const retryButton = document.getElementById("retry-button");

  let currentStatus = null;
  let billingActionPending = false;
  const organizationPicker = document.getElementById("billing-organization");
  const organizationNames = { en: "Organization", ko: "조직", ja: "組織", de: "Organisation", "zh-cn": "组织", "zh-tw": "組織" };
  document.getElementById("organization-label").textContent = organizationNames[locale];
  let organizationId = new URLSearchParams(location.search).get("organizationId") || "";
  const returnUrl = new URL(signupUrl); returnUrl.searchParams.set("return_to", location.href);
  document.querySelector("#billing-auth a").href = returnUrl.toString();
  function withOrganization(url) { const value = new URL(url, location.origin); if (organizationId) value.searchParams.set("organizationId", organizationId); return value.toString(); }
  async function loadOrganizations() {
    if (organizationPicker.options.length) return;
    const response = await fetch(`${apiUrl}/v1/organizations`, { credentials: "include" });
    if (!response.ok) return;
    const { organizations } = await response.json();
    for (const org of organizations) { const option = document.createElement("option"); option.value = org.id; option.textContent = org.name; organizationPicker.append(option); }
    if (organizations.some(org => org.id === organizationId)) organizationPicker.value = organizationId;
    organizationId = organizationPicker.value;
    upgradeLink.href = withOrganization(upgradeLink.href);
  }
  organizationPicker.addEventListener("change", () => { organizationId = organizationPicker.value; history.replaceState(null, "", withOrganization(location.href)); upgradeLink.href = withOrganization(upgradeLink.href); void load(); });

  function show(panel, errorMessage = labels.error) {
    loading?.classList.toggle("hidden", panel !== "loading");
    content?.classList.toggle("hidden", panel !== "content");
    auth?.classList.toggle("hidden", panel !== "auth");
    error?.classList.toggle("hidden", panel !== "error");
    if (panel === "error") document.getElementById("billing-error-message").textContent = errorMessage;
  }

  function formatPeriod(value) {
    if (!value) {
      return labels.noRenewalDate;
    }
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) {
      return labels.noRenewalDate;
    }
    return new Intl.DateTimeFormat(locale, {
      dateStyle: "medium",
    }).format(date);
  }

  function formatPlusPrice(billingInterval) {
    return `$${plusPricing[billingInterval]} ${billingInterval === "annual" ? yearLabel : monthLabel}`;
  }

  function plusChangeConfirmation(billingInterval) {
    return `${labels.plusUpgradeConfirm.replace("{price}", formatPlusPrice(billingInterval))}\n\n${plusOrganizationPrice}`;
  }

  function renderStatus(status) {
    currentStatus = status;
    const isActive = Boolean(status.active);
    const isStarter = status.planId === "starter";
    const isCanceled = status.status === "canceled";
    const isCanceling = isActive && (status.cancelAtPeriodEnd || isCanceled);
    const interval = status.billingInterval === "annual"
      ? labels.annual
      : status.billingInterval === "monthly"
        ? labels.monthly
        : labels.freeInterval;

    if (plan) {
      plan.textContent = status.planId === "plus" ? "Sync Plus" : isStarter ? labels.starterPlan : labels.freePlan;
    }
    price.classList.toggle("hidden", status.planId !== "plus" || !status.billingInterval);
    price.textContent = status.planId === "plus" && status.billingInterval
      ? formatPlusPrice(status.billingInterval)
      : "";
    if (badge) {
      badge.textContent = isCanceled
        ? labels.canceled
        : isCanceling
          ? labels.canceling
          : isActive
            ? interval
            : labels.freeInterval;
      badge.className = isCanceled || isCanceling
        ? "rounded border border-amber-400/30 bg-amber-400/10 px-2 py-1 text-[11px] font-medium text-amber-200"
        : isActive
          ? "rounded border border-emerald-400/30 bg-emerald-400/10 px-2 py-1 text-[11px] font-medium text-emerald-200"
          : "rounded border border-zinc-700 bg-zinc-950/60 px-2 py-1 text-[11px] font-medium text-zinc-400";
    }
    if (period) {
      period.textContent = isActive || isCanceled
        ? formatPeriod(status.periodEnd)
        : labels.noRenewalDate;
    }
    if (periodLabel) {
      periodLabel.textContent = isCanceled || isCanceling
        ? labels.endsOn
        : labels.renewal;
    }
    periodGroup?.classList.remove("hidden");
    if (message) {
      message.textContent = isCanceled && !isActive
        ? labels.canceledMessage
        : isCanceling
        ? labels.cancelingMessage
        : isActive
          ? labels.activeMessage
          : labels.freeMessage;
    }

    const canManageBilling = status.canManageBilling === true;
    manageButton?.classList.toggle("hidden", !isActive || !canManageBilling);
    const isChangeable = status.status === "active" || status.status === "trialing";
    const canChangePlan = isActive
      && isChangeable
      && !isCanceling
      && canManageBilling;
    const canSwitchToAnnual = canChangePlan
      && status.billingInterval === "monthly"
      && (status.planId !== "plus" || status.availablePlusIntervals?.includes("annual"));
    if (switchIntervalButton instanceof HTMLButtonElement) {
      switchIntervalButton.textContent = labels.switchToAnnual;
      switchIntervalButton.disabled = false;
      switchIntervalButton.classList.toggle("hidden", !canSwitchToAnnual);
    }
    upgradeLink?.classList.toggle("hidden", isActive);
    const plusCheckout = document.getElementById("plus-checkout");
    const plusPricingNote = document.getElementById("plus-pricing-note");
    plusCheckout.replaceChildren();
    plusPricingNote.classList.add("hidden");
    const canUpgradeToPlus = isStarter && canChangePlan;
    if ((!isActive && canManageBilling) || canUpgradeToPlus) {
      for (const billingInterval of status.availablePlusIntervals || []) {
        // An active annual subscription cannot move back to monthly billing.
        if (isActive && status.billingInterval === "annual" && billingInterval === "monthly") continue;
        const button = document.createElement("button");
        button.type = "button";
        button.className = "rounded border border-zinc-700 px-4 py-2 text-sm text-zinc-200 disabled:cursor-not-allowed disabled:opacity-50";
        button.textContent = `${canUpgradeToPlus ? labels.upgradeToPlus : "Sync Plus"} · ${formatPlusPrice(billingInterval)}`;
        button.addEventListener("click", async () => {
          if (billingActionPending) return;
          if (canUpgradeToPlus && !window.confirm(plusChangeConfirmation(billingInterval))) return;
          await submitBillingAction(canUpgradeToPlus ? "change" : "checkout", "plus", billingInterval, button);
        });
        plusCheckout.append(button);
        plusPricingNote.classList.remove("hidden");
      }
    }
    if (status.planId === "plus") plusPricingNote.classList.remove("hidden");
    show("content");
  }

  async function fetchStatus() {
    await loadOrganizations();
    const requestedOrganization = organizationId;
    const response = await fetch(withOrganization(`${apiUrl}/v1/billing/status`), {
      credentials: "include",
      headers: { accept: "application/json" },
    });
    if (response.status === 401) {
      show("auth");
      return;
    }
    if (!response.ok) {
      throw new Error("billing status failed");
    }
    const status = await response.json();
    if (requestedOrganization === organizationId) renderStatus(status);
  }

  async function openPortal() {
    if (!(manageButton instanceof HTMLButtonElement)) {
      return;
    }
    manageButton.disabled = true;

    try {
      const response = await fetch(`${apiUrl}/v1/billing/portal`, {
        method: "POST",
        credentials: "include",
        headers: {
          accept: "application/json",
          "content-type": "application/json",
        },
        body: JSON.stringify({ returnPath: new URL(withOrganization(returnPath)).pathname + new URL(withOrganization(returnPath)).search, organizationId }),
      });
      if (response.status === 401) {
        window.location.href = returnUrl.toString();
        return;
      }
      if (!response.ok) {
        throw new Error("billing portal failed");
      }

      const portal = await response.json();
      window.location.href = portal.url;
    } catch {
      manageButton.disabled = false;
      show("error");
    }
  }

  async function switchToAnnualBilling() {
    if (billingActionPending || !(switchIntervalButton instanceof HTMLButtonElement) || !currentStatus) {
      return;
    }
    if (currentStatus.billingInterval !== "monthly") {
      return;
    }
    if (!window.confirm(currentStatus.planId === "plus" ? plusChangeConfirmation("annual") : labels.switchConfirm)) {
      return;
    }
    await submitBillingAction("change", currentStatus.planId, "annual", switchIntervalButton);
  }

  async function submitBillingAction(action, planId, billingInterval, button) {
    if (billingActionPending) return;
    const requestedOrganization = organizationId;
    const previousStatus = currentStatus;
    const originalLabel = button.textContent;
    billingActionPending = true;
    organizationPicker.disabled = true;
    content.querySelectorAll("button").forEach((control) => { control.disabled = true; });
    button.textContent = labels.switching;

    try {
      const response = await fetch(`${apiUrl}/v1/billing/${action}`, {
        method: "POST",
        credentials: "include",
        headers: {
          accept: "application/json",
          "content-type": "application/json",
        },
        body: JSON.stringify({
          organizationId: requestedOrganization,
          planId,
          billingInterval,
        }),
      });
      if (requestedOrganization !== organizationId) return;
      if (response.status === 401) {
        window.location.href = returnUrl.toString();
        return;
      }
      if (!response.ok) {
        const failure = await response.json().catch(() => null);
        if (failure?.error === "billing_email_unavailable") {
          show("error", labels.billingEmailUnavailable);
          return;
        }
        throw new Error("billing change failed");
      }

      const result = await response.json();
      if (requestedOrganization !== organizationId) return;
      if (action === "checkout") {
        location.assign(result.url);
      } else {
        // Change responses omit the configured Plus intervals returned by status.
        renderStatus({ ...previousStatus, ...result });
      }
    } catch {
      if (requestedOrganization === organizationId) show("error");
    } finally {
      billingActionPending = false;
      organizationPicker.disabled = false;
      content.querySelectorAll("button").forEach((control) => { control.disabled = false; });
      button.textContent = originalLabel;
    }
  }

  async function load() {
    show("loading");
    try {
      await fetchStatus();
    } catch {
      show("error");
    }
  }

  manageButton?.addEventListener("click", openPortal);
  switchIntervalButton?.addEventListener("click", switchToAnnualBilling);
  retryButton?.addEventListener("click", load);
  load();
</script>
