---
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import Layout from "../layouts/Layout.astro";
import { localizedPath, ui, type Locale } from "../i18n";
import { PLUS_PRICING_USD } from "../billing/pricing";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const apiUrl = import.meta.env.PUBLIC_API_URL || "";
const authBaseUrl = apiUrl || Astro.url.origin;
const vaultsUrl = new URL("/vaults", authBaseUrl);
vaultsUrl.searchParams.set("lang", locale);
const signupUrl = new URL("/signup", authBaseUrl);
signupUrl.searchParams.set("return_to", vaultsUrl.toString());
signupUrl.searchParams.set("lang", locale);
const billingUrl = localizedPath(locale, "/billing");
const freeFeatures = [
  t.pricing.features.oneVault,
  t.pricing.features.freeStorage,
  t.pricing.features.freeFileSize,
  t.pricing.features.freeHistory,
];
const starterFeatures = [
  t.pricing.features.oneVault,
  t.pricing.features.starterStorage,
  t.pricing.features.starterFileSize,
  t.pricing.features.starterHistory,
];
const plusFeatures = [
  { label: t.pricing.features.plusOrganizationMembers },
  { label: t.pricing.features.plusVaults },
  {
    label: t.pricing.features.plusStorage,
    tooltip: t.pricing.features.plusStorageTooltip,
  },
  { label: t.pricing.features.plusFileSize },
  { label: t.pricing.features.plusHistory },
];
---

<Layout
  title={t.meta.pricingTitle}
  description={t.meta.pricingDescription}
  locale={locale}
>
  <div class="max-w-5xl mx-auto px-6 w-full flex-1 flex flex-col">
    <Header locale={locale} />

    <main class="flex-1 flex flex-col py-16">
      <div class="space-y-4 mb-12 text-center">
        <h1 class="text-2xl sm:text-3xl text-zinc-200 tracking-tight">
          {t.pricing.heading}
        </h1>
        <p class="text-zinc-500 max-w-md leading-relaxed mx-auto">
          {t.pricing.subheading}
        </p>
      </div>

      <div class="flex justify-center mb-6">
        <div
          class="grid grid-cols-2 gap-1 p-1 rounded bg-zinc-950/70 border border-zinc-800/50"
        >
          <button
            type="button"
            data-billing-interval="monthly"
            class="starter-billing-option min-w-20 cursor-pointer px-3 py-2 rounded text-xs text-zinc-950 bg-zinc-200"
          >
            {t.pricing.monthly}
          </button>
          <button
            type="button"
            data-billing-interval="annual"
            class="starter-billing-option min-w-20 cursor-pointer px-3 py-2 rounded text-xs text-zinc-400 hover:text-zinc-200"
          >
            {t.pricing.annual}
          </button>
        </div>
      </div>

      <div class="grid gap-6 md:grid-cols-3 max-w-5xl mx-auto w-full">
        <div
          class="p-6 rounded-lg border border-zinc-800/50 bg-zinc-900/20 flex flex-col"
        >
          <div class="mb-8">
            <h3 class="text-zinc-200 font-normal mb-2">{t.pricing.freePlan}</h3>
            <div class="flex items-baseline gap-1">
              <span class="text-2xl text-zinc-200">$0</span>
              <span class="text-xs text-zinc-500">{t.pricing.forever}</span>
            </div>
          </div>

          <ul class="space-y-4 mb-8 text-xs flex-1 text-zinc-400">
            {
              freeFeatures.map((feature) => (
                <li class="flex items-center gap-3">
                  <div class="w-1 h-1 rounded-full bg-zinc-600" />
                  {feature}
                </li>
              ))
            }
          </ul>

          <a
            href={signupUrl.toString()}
            class="w-full py-2 px-4 text-center text-xs bg-zinc-800 text-zinc-200 hover:bg-zinc-700 rounded transition-colors"
          >
            {t.home.getStarted}
          </a>
        </div>

        <div
          class="p-6 rounded-lg border border-zinc-800/50 bg-zinc-900/20 flex flex-col"
        >
          <div class="mb-8">
            <h3 class="text-zinc-200 font-normal mb-2">
              {t.pricing.starterPlan}
            </h3>
            <div class="flex items-baseline gap-2">
              <span id="starter-price" class="text-2xl text-zinc-200">$1</span>
              <span id="starter-interval" class="text-xs text-zinc-500">
                {t.pricing.month}
              </span>
              <span
                id="starter-original-price"
                class="hidden text-xs text-zinc-600 line-through"
              >
                $12
              </span>
            </div>
          </div>

          <ul class="space-y-4 mb-8 text-xs flex-1 text-zinc-400">
            {
              starterFeatures.map((feature) => (
                <li class="flex items-center gap-3">
                  <div class="w-1 h-1 rounded-full bg-zinc-600" />
                  {feature}
                </li>
              ))
            }
          </ul>

          <button
            id="starter-checkout-button"
            type="button"
            class="w-full cursor-pointer py-2 px-4 text-center text-xs bg-zinc-200 text-[#0a0a0a] hover:bg-white disabled:bg-zinc-800/50 disabled:text-zinc-500 disabled:cursor-not-allowed rounded transition-colors"
          >
            {t.home.getStarted}
          </button>
        </div>

        <div
          class="p-6 rounded-lg border border-zinc-800/50 bg-zinc-900/20 flex flex-col"
        >
          <div class="mb-8">
            <h3 class="text-zinc-200 font-normal mb-2">{t.pricing.plusPlan}</h3>
            <div class="flex items-baseline gap-1">
              <span id="plus-price" class="text-2xl text-zinc-200">${PLUS_PRICING_USD.monthly}</span>
              <span id="plus-interval" class="text-xs text-zinc-500">{t.pricing.month}</span>
            </div>
          </div>

          <ul class="space-y-4 mb-8 text-xs flex-1 text-zinc-400">
            {
              plusFeatures.map((feature) => (
                <li class="flex items-center gap-3">
                  <div class="w-1 h-1 rounded-full bg-zinc-600" />
                  <span class="inline-flex items-center gap-1.5">
                    <span>{feature.label}</span>
                    {feature.tooltip && (
                      <span class="group relative inline-flex">
                        <button
                          type="button"
                          aria-label={feature.tooltip}
                          class="flex h-4 w-4 items-center justify-center rounded-full border border-zinc-700 text-[10px] leading-none text-zinc-500 transition-colors hover:border-zinc-500 hover:text-zinc-300 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-zinc-500"
                        >
                          ?
                        </button>
                        <span
                          aria-hidden="true"
                          class="pointer-events-none absolute bottom-6 left-1/2 z-10 w-max max-w-36 -translate-x-1/2 rounded border border-zinc-700 bg-zinc-950 px-2 py-1 text-[10px] leading-snug text-zinc-300 opacity-0 shadow-lg transition-opacity group-hover:opacity-100 group-focus-within:opacity-100"
                        >
                          {feature.tooltip}
                        </span>
                      </span>
                    )}
                  </span>
                </li>
              ))
            }
          </ul>

          <button
            id="plus-checkout-button"
            type="button"
            class="w-full cursor-pointer py-2 px-4 text-center text-xs bg-zinc-200 text-[#0a0a0a] hover:bg-white disabled:bg-zinc-800/50 disabled:text-zinc-500 disabled:cursor-not-allowed rounded transition-colors"
          >
            {t.home.getStarted}
          </button>
        </div>
      </div>
      <p id="checkout-error" role="alert" class="mt-6 text-sm text-red-400"></p>
    </main>

    <Footer locale={locale} />
  </div>
</Layout>

<script
  define:vars={{
    apiUrl,
    signupUrl: signupUrl.toString(),
    billingUrl,
    monthLabel: t.pricing.month,
    yearLabel: t.pricing.year,
    plusPricing: PLUS_PRICING_USD,
    billingEmailUnavailable: t.billingSettings.billingEmailUnavailable,
  }}
>
  const checkoutButtons = ["starter", "plus"].map((planId) => ({
    planId,
    button: document.getElementById(`${planId}-checkout-button`),
  })).filter(({ button }) => button instanceof HTMLButtonElement);
  let checkoutPending = false;
  const checkoutError = document.getElementById("checkout-error");
  const starterOriginalPrice = document.getElementById(
    "starter-original-price",
  );
  const starterPrice = document.getElementById("starter-price");
  const starterInterval = document.getElementById("starter-interval");
  const plusPrice = document.getElementById("plus-price");
  const plusInterval = document.getElementById("plus-interval");
  const billingOptionButtons = Array.from(
    document.querySelectorAll(".starter-billing-option"),
  );
  let selectedBillingInterval = "monthly";

  const pricingByInterval = {
    monthly: {
      price: "$1",
      label: monthLabel,
      originalPrice: "",
    },
    annual: {
      price: "$10",
      label: yearLabel,
      originalPrice: "$12",
    },
  };

  function selectBillingInterval(billingInterval) {
    if (!(billingInterval in pricingByInterval)) {
      return;
    }

    selectedBillingInterval = billingInterval;
    const pricing = pricingByInterval[billingInterval];
    if (starterPrice) {
      starterPrice.textContent = pricing.price;
    }
    if (starterOriginalPrice) {
      starterOriginalPrice.textContent = pricing.originalPrice;
      starterOriginalPrice.classList.toggle("hidden", !pricing.originalPrice);
    }
    if (starterInterval) {
      starterInterval.textContent = pricing.label;
    }
    if (plusPrice) {
      plusPrice.textContent = `$${plusPricing[billingInterval]}`;
    }
    if (plusInterval) {
      plusInterval.textContent = pricing.label;
    }

    for (const button of billingOptionButtons) {
      const isSelected = button.dataset.billingInterval === billingInterval;
      button.classList.toggle("bg-zinc-200", isSelected);
      button.classList.toggle("text-zinc-950", isSelected);
      button.classList.toggle("text-zinc-400", !isSelected);
      button.classList.toggle("hover:text-zinc-200", !isSelected);
    }
  }

  for (const button of billingOptionButtons) {
    button.addEventListener("click", () => {
      selectBillingInterval(button.dataset.billingInterval);
    });
  }

  for (const { planId, button } of checkoutButtons) {
    button.addEventListener("click", async () => {
      if (checkoutPending) return;
      checkoutError.textContent = "";
      checkoutPending = true;
      for (const { button } of checkoutButtons) button.disabled = true;

      try {
        const response = await fetch(`${apiUrl}/v1/billing/checkout`, {
          method: "POST",
          credentials: "include",
          headers: {
            accept: "application/json",
            "content-type": "application/json",
          },
          body: JSON.stringify({
            organizationId: new URLSearchParams(location.search).get("organizationId") || undefined,
            planId,
            billingInterval: selectedBillingInterval,
          }),
        });

        if (response.status === 401) {
          const target = new URL(signupUrl); target.searchParams.set("return_to", location.href); window.location.href = target.toString();
          return;
        }
        if (response.status === 409) {
          const failure = await response.json();
          if (failure.error === "billing_email_unavailable") {
            checkoutError.textContent = billingEmailUnavailable;
            throw new Error("billing email unavailable");
          }
          const target = new URL(billingUrl, location.origin); const organizationId = new URLSearchParams(location.search).get("organizationId"); if (organizationId) target.searchParams.set("organizationId", organizationId); window.location.href = target.toString();
          return;
        }

        if (!response.ok) {
          throw new Error("checkout failed");
        }

        const checkout = await response.json();
        window.location.href = checkout.url;
      } catch {
        checkoutPending = false;
        for (const { button } of checkoutButtons) button.disabled = false;
      }
    });
  }
</script>
