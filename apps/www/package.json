{
  "name": "www",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "test:redirects": "node --test test/canonical-url.test.mjs test/worker-redirect.test.mjs",
    "test:billing": "node --test test/billing-settings.test.mjs test/billing-success.test.mjs test/pricing-checkout.test.mjs",
    "preview": "astro preview",
    "preview:cloudflare": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:built": "wrangler deploy",
    "astro": "astro",
    "storybook": "storybook dev -p 6007 --no-open --disable-telemetry",
    "build:storybook": "storybook build --disable-telemetry",
    "typecheck:storybook": "tsgo --noEmit -p .storybook/tsconfig.json"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/sitemap": "^3.7.6",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@storybook-astro/framework": "1.18.0",
    "@storybook/builder-vite": "10.6.9",
    "msw": "^3.0.7",
    "msw-storybook-addon": "^3.0.3",
    "storybook": "10.6.9",
    "wrangler": "^4.168.0"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
